# CopilotKit's runtime reports usage to its servers unless this is set. DSAgent
# runs on private data; nothing here should call home by default. Documented at
# https://docs.copilotkit.ai/telemetry
COPILOTKIT_TELEMETRY_DISABLED=true

# Where `dsagent serve` is listening. Override per environment.
DSAGENT_URL=http://localhost:8000/agent
